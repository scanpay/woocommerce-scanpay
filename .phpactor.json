{
	"php.version": "8.0",
	"php_code_sniffer.enabled": true,
	"indexer.follow_symlinks": true,
	"indexer.supported_extensions": ["php"],
	"indexer.include_patterns": ["/src/**/*.php"],
	"indexer.stub_paths": [
		"%application_root%/vendor/jetbrains/phpstorm-stubs",
		"%project_root%/.stubs/wordpress",
		"%project_root%/.stubs/woocommerce",
		"%project_root%/.stubs/woocommerce-subscriptions"
	]
}
