msgstr "Betal med MobilePay"

#: hooks/class-wc-scanpay-blocks-support.php:63
msgid "Betal med Apple Pay"
msgstr "Betal med Apple Pay"

#: includes/admin-options.php:49
msgid "Welcome to Scanpay for WooCommerce!"
msgstr "Velkommen til Scanpay for WooCommerce!"

#: includes/admin-options.php:52
msgid "installation guide"
msgstr "installationsvejledning"

#. translators: %s is a link to the installation guide
#: includes/admin-options.php:54
#, php-format
msgid "Please follow the instructions in the %s."
msgstr "Følg venligst instruktionerne i %s."

#: includes/admin-options.php:64
#: includes/gjold-notice.php:40
msgid "Scanpay is becoming Gjold"
msgstr "Scanpay bliver til Gjold"

#: includes/form-fields.php:9
msgid "Enable Scanpay in the checkout."
msgstr "Aktiver Scanpay i checkout."

#: includes/form-fields.php:13
msgid "API key"
msgstr "API-nøgle"

#: includes/form-fields.php:21
msgid "A title for the payment method. This is displayed on the checkout page."
msgstr "En titel for betalingsmetoden. Denne vises i din checkout."

#: includes/form-fields.php:33
msgid "Card icons"
msgstr "Kortikoner"

#: includes/form-fields.php:35
msgid "Choose which card icons to display on the checkout page."
msgstr "Vælg hvilke kortikoner, der skal vises i din checkout."

#: includes/form-fields.php:55
msgid "Use default checkout stylesheet (CSS)."
msgstr "Brug vores checkout stylesheet (CSS)."

#: includes/form-fields.php:63
msgid "Disable"
msgstr "Deaktiver"

#: includes/form-fields.php:64
msgid "On order completion (recommended)"
msgstr "Når ordren er gennemført (anbefalet)"

#: includes/form-fields.php:65
msgid "Immediately"
msgstr "Omgående"

#: includes/form-fields.php:71
msgid "Auto-complete virtual orders."
msgstr "Automatisk fuldførelse af virtuelle ordrer."

#: includes/form-fields.php:77
msgid "Auto-complete new subscribers <i>(Subscriptions only)</i>."
msgstr "Automatisk fuldførelse af nye abonnenter <i>(abonnementsbetalinger)</i>."

#: includes/form-fields.php:83
msgid "Auto-complete renewal orders <i>(Subscriptions only)</i>."
msgstr "Automatisk fuldførelse af fornyelsesordrer <i>(abonnementsbetalinger)</i>."

#: includes/form-fields.php:87
msgid "Subscription Terms"
msgstr "Abonnementsbetingelser"

#: includes/form-fields.php:89
msgid "Add a checkbox for Subscription Terms and Conditions."
msgstr "Tilføj en checkbox for abonnementsbetingelser."

#: includes/form-fields.php:92
msgid "Hide checkbox"
msgstr "Skjul checkbox"

#: includes/gjold-notice.php:18
msgid "Scanpay is changing its name to Gjold. This version of the plugin already uses our new gjold.com domain. No action is required."
msgstr "Scanpay skifter navn til Gjold. Denne version af pluginet bruger allerede vores nye domæne, gjold.com. Du skal ikke foretage dig noget."

#. translators: %1$s is the current dashboard address, %2$s is the new dashboard address
#: includes/gjold-notice.php:21
#, php-format
msgid "You can continue to use the dashboard at %1$s. In a few days, it will also be available at %2$s, and both addresses will work. Over the coming weeks, we will phase out %1$s, so please switch to %2$s once it is available."
msgstr "Du kan fortsat bruge dashboardet på %1$s. Om få dage vil det også være tilgængeligt på %2$s, og begge adresser vil virke. I løbet af de kommende uger udfaser vi %1$s, så skift venligst til %2$s, når det er tilgængeligt."

#: includes/gjold-notice.php:25
msgid "In a few weeks, we will also release a new and much improved Gjold plugin for WooCommerce. We will let you know when it is ready."
msgstr "Om nogle uger lancerer vi også et nyt og markant forbedret Gjold-plugin til WooCommerce. Vi giver besked, når det er klar."

#: includes/gjold-notice.php:42
msgid "Dismiss this notice"
msgstr "Skjul denne besked"

#: woocommerce-scanpay.php:267
msgid "Settings"
msgstr "Indstillinger"
