msgstr "Kortikoner"

#: admin/settings/fields/scanpay.php:51
msgid "Choose which card icons to display at checkout."
msgstr "Vælg hvilke kortikoner der skal vises ved checkout."

#: admin/settings/fields/scanpay.php:69
msgid "Stylesheet"
msgstr "Stylesheet"

