msgstr "Apple Pay via Scanpay."

#: gateways/class-wc-scanpay-gateway-applepay.php:12
#: gateways/class-wc-scanpay-gateway-mobilepay.php:12
#: includes/form-fields.php:7
msgid "Enable"
msgstr "Aktiver"

#: gateways/class-wc-scanpay-gateway-applepay.php:14
msgid "Enable Apple Pay in the checkout."
msgstr "Aktiver Apple Pay i checkout."

#: gateways/class-wc-scanpay-gateway-applepay.php:18
#: gateways/class-wc-scanpay-gateway-mobilepay.php:18
#: includes/form-fields.php:19
