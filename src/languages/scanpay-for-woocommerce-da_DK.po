msgstr "Titlen på betalingsmetoden, som vises ved checkout."

#: admin/settings/fields/scanpay_applepay.php:25
#: admin/settings/fields/scanpay_mobilepay.php:25
msgid "The payment method description shown at checkout."
msgstr "Beskrivelsen af betalingsmetoden, som vises ved checkout."

#: admin/settings/fields/scanpay_mobilepay.php:11
msgid "Enable MobilePay at checkout."
msgstr "Aktiver MobilePay ved checkout."

#: gateways/abstract-wc-gateway-scanpay-base.php:176
msgid "Error: Scanpay requires the PHP cURL extension, which is not installed on this server."
msgstr "Fejl: Scanpay kræver PHP-udvidelsen cURL, som ikke er installeret på denne server."

#: gateways/abstract-wc-gateway-scanpay-base.php:210
msgid "Error: Invalid Scanpay API key. Please check your key and try again."
msgstr "Fejl: Ugyldig Scanpay API-nøgle. Kontroller din nøgle, og prøv igen."

#: gateways/abstract-wc-gateway-scanpay-base.php:271
msgid "Paste your Scanpay API key"
msgstr "Indsæt din Scanpay API-nøgle"

#: gateways/abstract-wc-gateway-scanpay-base.php:276
msgid "To use a different Scanpay account, delete the local Scanpay data first. Nothing is lost for good: it is re-synced from Scanpay once you add a key."
msgstr "Hvis du vil bruge en anden Scanpay-konto, skal du først slette de lokale Scanpay-data. Intet går tabt for altid: data synkroniseres igen fra Scanpay, så snart du tilføjer en nøgle."

#: gateways/abstract-wc-gateway-scanpay-base.php:280
msgid "Delete data and change API key"
msgstr "Slet data og skift API-nøgle"

#: gateways/abstract-wc-gateway-scanpay-base.php:347
msgid "Error: The Scanpay API key cannot be replaced. Delete the local Scanpay data first."
msgstr "Fejl: Scanpay API-nøglen kan ikke udskiftes. Slet først de lokale Scanpay-data."

#: gateways/abstract-wc-gateway-scanpay-base.php:361
msgid "Error: The Scanpay API key is malformed. It should look like \"1234:xxxxxxxx\"."
msgstr "Fejl: Scanpay API-nøglen har et forkert format. Den skal se ud som \"1234:xxxxxxxx\"."

#. translators: %s is a link to the subscription terms page.
#: gateways/blocks/class-wc-scanpay-blocks-support.php:81
#: public/wcs-scanpay-checkout-terms.php:23
#, php-format
