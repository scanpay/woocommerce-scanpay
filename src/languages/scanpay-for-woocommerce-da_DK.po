msgstr "Aktiver MobilePay i checkout."

#: gateways/class-wc-scanpay-gateway.php:9
msgid "Accept payment cards through Scanpay."
msgstr "Accepter betalingskort via Scanpay."

#: hooks/class-wc-scanpay-blocks-support.php:55
