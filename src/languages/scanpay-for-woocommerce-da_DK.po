msgstr "Accepter betalingskort via Scanpay."

#: gateways/class-wc-gateway-scanpay-mobilepay.php:11
msgid "MobilePay Online through Scanpay."
msgstr "MobilePay Online via Scanpay."

#. translators: %s is the captured amount with its currency, e.g. "99.00 DKK".
#: library/class-wc-scanpay-capture.php:127
#, php-format
msgid "Scanpay capture of %s completed."
msgstr "Scanpay-hævning af %s er gennemført."

#. translators: %s is the raw failure reason, which is not translated.
#: library/class-wc-scanpay-capture.php:193
#, php-format
msgid "Scanpay capture failed: %s"
msgstr "Scanpay-hævning mislykkedes: %s"

#. translators: 1: authorized amount, 2: order total, 3: currency code.
#: library/class-wc-scanpay-sync.php:290
#, php-format
msgid "Scanpay: the authorized amount (%1$s %3$s) does not cover the order total (%2$s %3$s); the order was not marked as paid."
msgstr "Scanpay: det autoriserede beløb (%1$s %3$s) dækker ikke ordretotalen (%2$s %3$s); ordren blev ikke markeret som betalt."

#. translators: 1: Scanpay transaction or charge label, e.g. "charge #4321". 2: WooCommerce order ID.
#: library/class-wc-scanpay-sync.php:402
#, php-format
msgid "Scanpay holds a successful payment for this order (%1$s), but WooCommerce could not complete order #%2$d. Reconcile the order manually: the payment is settled at Scanpay and nothing will retry the completion."
msgstr "Scanpay har en gennemført betaling for denne ordre (%1$s), men WooCommerce kunne ikke fuldføre ordre #%2$d. Afstem ordren manuelt: betalingen er afregnet hos Scanpay, og fuldførelsen bliver ikke forsøgt igen."

#: library/class-wc-scanpay-sync.php:511
msgid "Subscription initiated without payment."
msgstr "Abonnement oprettet uden betaling."

#: library/class-wcs-scanpay-charge.php:78
msgid "Invalid Scanpay subscriber ID."
msgstr "Ugyldigt Scanpay-abonnent-ID."

#: library/class-wcs-scanpay-charge.php:97
msgid "No Scanpay API key is configured."
msgstr "Der er ikke konfigureret nogen Scanpay API-nøgle."

#: library/class-wcs-scanpay-charge.php:106
msgid "Invalid Scanpay API key configured."
msgstr "Der er konfigureret en ugyldig Scanpay API-nøgle."

#. translators: 1: Scanpay shop ID the subscription was created under, 2: the shop ID of the configured API key.
#: library/class-wcs-scanpay-charge.php:141
#, php-format
msgid "This subscription belongs to Scanpay shop %1$d, not %2$d."
msgstr "Dette abonnement tilhører Scanpay-butik %1$d, ikke %2$d."

#. translators: 1: amount supplied by WooCommerce Subscriptions, 2: the order total.
#: library/class-wcs-scanpay-charge.php:167
#, php-format
msgid "Invalid renewal amount (%1$s) or order total (%2$s)."
msgstr "Ugyldigt fornyelsesbeløb (%1$s) eller ordretotal (%2$s)."

#. translators: 1: amount supplied by WooCommerce Subscriptions, 2: the order total.
#: library/class-wcs-scanpay-charge.php:183
#, php-format
msgid "The renewal amount (%1$s) does not match the order total (%2$s)."
msgstr "Fornyelsesbeløbet (%1$s) stemmer ikke overens med ordretotalen (%2$s)."

#: library/class-wcs-scanpay-charge.php:205
msgid "The zero-amount renewal could not be completed."
msgstr "Fornyelsen uden beløb kunne ikke gennemføres."

#: library/class-wcs-scanpay-charge.php:365
msgid "The Scanpay charge failed. See the WooCommerce logs for details."
msgstr "Scanpay-trækket mislykkedes. Se WooCommerce-logfilerne for detaljer."

#: public/generate-payment-link.php:80
msgid "Error: The order does not exist. Please create a new order or contact support."
msgstr "Fejl: Ordren findes ikke. Opret en ny ordre, eller kontakt support."

#: public/generate-payment-link.php:84
msgid "Error: The payment plugin is not configured. Please contact support."
msgstr "Fejl: Betalingspluginnet er ikke konfigureret. Kontakt venligst support."

#: public/generate-payment-link.php:153
#: public/generate-payment-link.php:220
#: public/generate-payment-link.php:283
#: public/generate-payment-link.php:330
msgid "Error: We could not create a link to the payment window. Please wait a moment and try again."
msgstr "Fejl: Vi kunne ikke oprette et link til betalingsvinduet. Vent et øjeblik, og prøv igen."

#: public/generate-payment-link.php:178
msgid "Your payment details were updated. This renewal has not been charged yet; it will be collected automatically with the new details."
msgstr "Dine betalingsoplysninger er opdateret. Denne fornyelse er endnu ikke trukket; beløbet bliver opkrævet automatisk med de nye oplysninger."

#: woocommerce-scanpay.php:428
msgid "The Scanpay renewal could not be processed. See the WooCommerce logs for details."
msgstr "Scanpay-fornyelsen kunne ikke behandles. Se WooCommerce-logfilerne for detaljer."

