msgid "Enable Apple&nbsp;Pay at checkout."
msgstr "Aktiver Apple&nbsp;Pay ved checkout."

#: admin/settings/fields/scanpay_applepay.php:18
#: admin/settings/fields/scanpay_mobilepay.php:18
