#: admin/assets/js/settings.js:98
msgid "Initiate synchronization"
msgstr "Start synkronisering"

#: admin/assets/js/settings.js:99
msgid "Please click <i>'send ping'</i> to initiate the synchronization with the scanpay backend."
msgstr "Klik på <i>'send ping'</i> for at starte synkroniseringen med Scanpays backend."

#. translators: %d is a number of seconds.
#: admin/assets/js/settings.js:112
#, js-format
msgid "<b>Synchronized:</b> %d second ago."
msgid_plural "<b>Synchronized:</b> %d seconds ago."
msgstr[0] "<b>Synkroniseret:</b> for %d sekund siden."
msgstr[1] "<b>Synkroniseret:</b> for %d sekunder siden."

#: admin/assets/js/settings.js:118
msgid "Warning: Your system may be out of sync"
msgstr "Advarsel: Dit system er muligvis ude af synkronisering"

#. translators: %d is a number of minutes.
#: admin/assets/js/settings.js:121
#, js-format
msgid "More than %d minute has passed since the last received ping. Please check your <i>API key</i> and click <i>'send ping'</i>."
msgid_plural "More than %d minutes have passed since the last received ping. Please check your <i>API key</i> and click <i>'send ping'</i>."
msgstr[0] "Der er gået mere end %d minut siden det senest modtagne ping. Kontroller din <i>API-nøgle</i>, og klik på <i>'send ping'</i>."
msgstr[1] "Der er gået mere end %d minutter siden det senest modtagne ping. Kontroller din <i>API-nøgle</i>, og klik på <i>'send ping'</i>."

#: admin/assets/js/settings.js:133
msgid "Warning: Your system is out of sync"
msgstr "Advarsel: Dit system er ude af synkronisering"

#: admin/assets/js/settings.js:134
msgid "A long time has passed since the last received ping. Please check your <i>API key</i> and click <i>'send ping'</i>."
msgstr "Der er gået lang tid siden det senest modtagne ping. Kontroller din <i>API-nøgle</i>, og klik på <i>'send ping'</i>."

#: admin/assets/js/settings.js:143
msgid "Error: Something went wrong"
msgstr "Fejl: Noget gik galt"

#: admin/assets/js/settings.js:144
msgid "Your system responded with the following error message: "
msgstr "Dit system svarede med følgende fejlmeddelelse: "

#: admin/assets/js/settings.js:166
msgid ""
"Delete all local Scanpay data and clear the API key?\n"
"\n"
"This deletes the local payment tables and disables the Scanpay gateways. It does not affect anything at Scanpay: adding a key for the same shop re-syncs the data automatically."
msgstr ""
"Slet alle lokale Scanpay-data og ryd API-nøglen?\n"
"\n"
"Dette sletter de lokale betalingstabeller og deaktiverer Scanpay-gatewayene. Det påvirker intet hos Scanpay: tilføjer du en nøgle til den samme butik, synkroniseres data automatisk igen."

#: admin/assets/js/settings.js:174
msgid "Deleting…"
msgstr "Sletter…"

#. translators: %s is the raw error code the server returned, which is not translated.
#: admin/assets/js/settings.js:184
#, js-format
msgid " Could not delete the data: %s"
msgstr " Kunne ikke slette data: %s"

#: admin/assets/js/settings.js:194
msgid "You can find your Scanpay API key <a target=\"_blank\" href=\"https://dashboard.scanpay.dk/settings/api\">here</a>."
msgstr "Du finder din Scanpay API-nøgle <a target=\"_blank\" href=\"https://dashboard.scanpay.dk/settings/api\">her</a>."

#: admin/assets/js/settings.js:215
msgid "There is a new version of the plugin available. "
msgstr "Der findes en ny version af pluginnet. "

#. translators: %1$s is the installed plugin version. The <span> is filled in with the latest version.
#: admin/assets/js/settings.js:218
#, js-format
msgid "Your Scanpay extension (<i>%1$s</i>) needs to be updated to <span class=\"wcsp-set-version\"></span> (<a href=\"//github.com/scanpay/woocommerce-scanpay/releases\" target=\"_blank\">changelog</a>)."
msgstr "Din Scanpay-udvidelse (<i>%1$s</i>) skal opdateres til <span class=\"wcsp-set-version\"></span> (<a href=\"//github.com/scanpay/woocommerce-scanpay/releases\" target=\"_blank\">ændringslog</a>)."

