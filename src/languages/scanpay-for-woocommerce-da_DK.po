msgstr "Titel"

#: gateways/class-wc-scanpay-gateway-applepay.php:20
#: gateways/class-wc-scanpay-gateway-mobilepay.php:20
msgid "A title for the payment method on the checkout page."
msgstr "En titel for betalingsmetoden på betalingsside."

#: gateways/class-wc-scanpay-gateway-applepay.php:25
#: gateways/class-wc-scanpay-gateway-mobilepay.php:25
#: includes/form-fields.php:26
