msgstr "Beskrivelse"

#: gateways/class-wc-scanpay-gateway-applepay.php:27
#: gateways/class-wc-scanpay-gateway-mobilepay.php:27
#: includes/form-fields.php:28
msgid "A description of the payment method. This is displayed on the checkout page."
msgstr "En beskrivelse af betalingsmetoden. Denne vises på betalingsside."

#: gateways/class-wc-scanpay-gateway-mobilepay.php:9
msgid "MobilePay Online through Scanpay."
msgstr "MobilePay Online via Scanpay."

#: gateways/class-wc-scanpay-gateway-mobilepay.php:14
