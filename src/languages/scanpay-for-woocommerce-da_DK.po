msgstr "https://wordpress.org/plugins/scanpay-for-woocommerce/"

#. Description of the plugin
#: woocommerce-scanpay.php:6
msgid "Accept payments in WooCommerce with a secure payment gateway."
msgstr "Accepter betalinger i WooCommerce med en sikker betalingsgateway."

#. Author of the plugin
#: woocommerce-scanpay.php:7
msgid "Scanpay"
msgstr "Scanpay"

#. Author URI of the plugin
#: woocommerce-scanpay.php:8
