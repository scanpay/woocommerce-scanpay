msgid "Auto-capture"
msgstr "Automatisk hævning"

#: admin/settings/fields/scanpay.php:80
msgid "Disable"
msgstr "Deaktiver"

#: admin/settings/fields/scanpay.php:81
msgid "On order completion (recommended)"
msgstr "Når ordren er gennemført (anbefalet)"

#: admin/settings/fields/scanpay.php:82
msgid "Immediately"
msgstr "Omgående"

#: admin/settings/fields/scanpay.php:87
msgid "Auto-complete"
msgstr "Automatisk gennemførsel"

#: admin/settings/fields/scanpay.php:89
msgid "Automatically mark virtual orders as completed."
msgstr "Markér automatisk virtuelle ordrer som gennemført."

#: admin/settings/fields/scanpay.php:99
msgid "Auto-complete subscriptions"
msgstr "Automatisk gennemførsel af abonnementer"

#: admin/settings/fields/scanpay.php:101
msgid "Auto-complete new subscription orders (Subscriptions only)."
msgstr "Gennemfør automatisk nye abonnementsordrer (kun med Subscriptions)."

#: admin/settings/fields/scanpay.php:102
msgid "Force the first order of a new subscription to Completed when Scanpay confirms the payment, instead of the status WooCommerce would otherwise set."
msgstr "Gennemtving status Gennemført på den første ordre i et nyt abonnement, når Scanpay bekræfter betalingen, i stedet for den status WooCommerce ellers ville sætte."

#: admin/settings/fields/scanpay.php:108
msgid "Auto-complete renewals"
msgstr "Automatisk gennemførsel af fornyelser"

#: admin/settings/fields/scanpay.php:110
msgid "Auto-complete renewal orders (Subscriptions only)."
msgstr "Gennemfør automatisk fornyelsesordrer (kun med Subscriptions)."

#: admin/settings/fields/scanpay.php:111
msgid "Force a renewal order to Completed when Scanpay confirms the charge, instead of the status WooCommerce would otherwise set."
msgstr "Gennemtving status Gennemført på en fornyelsesordre, når Scanpay bekræfter trækket, i stedet for den status WooCommerce ellers ville sætte."

#: admin/settings/fields/scanpay.php:117
msgid "Subscription terms"
msgstr "Abonnementsvilkår"

#: admin/settings/fields/scanpay.php:119
msgid "Add a checkbox for subscription terms and conditions at checkout."
msgstr "Tilføj en checkbox til abonnementsvilkår ved checkout."

