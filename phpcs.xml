<?xml version="1.0"?>
<ruleset name="scanpay-woocommerce-cs">
    <file>src</file>
    <arg name="colors"/>
    <config name="minimum_supported_wp_version" value="6.3"/>
    <config name="testVersion" value="8.0-"/>
    <arg name="parallel" value="16"/>

    <!-- Base standards -->
    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- I18n: enforce your text-domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="scanpay-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- WooCommerce registers these capabilities; they are not core WP caps. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_shop_orders"/>
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- WordPress customizations -->
    <rule ref="WordPress">
        <!-- Prefer [] and forbid long arrays -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

		<!-- Allow cURL, fopen etc. -->
		<exclude name="WordPress.WP.AlternativeFunctions"/>

		<!-- Prepared SQL: not always needed -->
		<exclude name="WordPress.DB.PreparedSQL"/>

		<!-- The plugin owns scanpay_seq/_meta/_subs outright, so $wpdb is the only way
		     to reach them: no WP API wraps custom tables, there is nothing to cache
		     behind (sync is the cache), and install.php must issue DDL. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>

		<!-- Short ternaries (a ?: b) are allowed as a deliberate style choice -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!-- Documentation sniffs off (Extra) -->
    <rule ref="WordPress-Extra">
        <exclude name="Squiz.Commenting"/>
    </rule>

    <!-- Gateway field files are named after the gateway id (e.g. scanpay_mobilepay),
         which must contain underscores to match the lazy require in get_form_fields(). -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>src/admin/settings/fields/</exclude-pattern>
    </rule>

    <!-- Allow abstract class filenames -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/abstract-*.php</exclude-pattern>
    </rule>
</ruleset>
